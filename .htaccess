# Configuración Apache para desguace.cochecierto.com en Hostinger

# Juego de caracteres predeterminado
AddDefaultCharset UTF-8

# Archivo de inicio predeterminado
DirectoryIndex index.html

# Forzar HTTPS (si SSL está activo en Hostinger)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP_HOST} ^desguace\.cochecierto\.com$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Cabeceras de seguridad básicas
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Control de caché para CSS y JS (evita que el navegador use versiones viejas)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 hour"
    ExpiresByType application/javascript "access plus 1 hour"
</IfModule>
